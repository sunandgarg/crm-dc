# Runtime
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:8080
VITE_API_URL=http://localhost:4000

# PostgreSQL / Prisma
DATABASE_URL=postgresql://crm:crm@localhost:5432/crm_dc?schema=public

# Authentication
JWT_SECRET=replace-with-at-least-32-random-characters
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=CRM Administrator
INBOUND_API_KEY=replace-with-a-long-random-api-key
WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
META_VERIFY_TOKEN=replace-with-meta-verification-token
META_APP_SECRET=replace-with-meta-app-secret
GOOGLE_ADS_WEBHOOK_SECRET=replace-with-google-webhook-secret
NETCORE_WEBHOOK_SECRET=replace-with-netcore-webhook-secret

# Background scheduler. Runs inside the API process.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60

# AI uses a local deterministic rules engine by default. External data is only
# transmitted when AI_MODE is explicitly changed to openai_compatible.
AI_MODE=rules
AI_API_URL=https://api.openai.com/v1
AI_MODEL=configure-model-name
# AI_API_KEY=
AI_TIMEOUT_SECONDS=30
AI_MAX_INPUT_CHARS=20000

# AWS SES
AWS_REGION=ap-south-1
SES_FROM_EMAIL=no-reply@example.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# S3 or Cloudflare R2. For R2, set endpoint and account credentials.
STORAGE_PROVIDER=s3
STORAGE_BUCKET=crm-dc
STORAGE_REGION=ap-south-1
# STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_PUBLIC_BASE_URL=

# Local object storage from docker-compose.yml
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_ACCESS_KEY_ID=minio
# STORAGE_SECRET_ACCESS_KEY=minio-secret
